Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Fast-LIO Point Cloud
      Enabled: true
      Topic:
        Value: /record/cloud_registered
        Reliability Policy: Reliable
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/Path
      Name: Fast-LIO Path
      Enabled: true
      Topic:
        Value: /fastlio_path
        Reliability Policy: Reliable
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Topic:
        Value: /camera/depth/image_rect_raw
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
Window Geometry:
  Height: 900
  Width: 1440

