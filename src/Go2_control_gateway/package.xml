<?xml version="1.0"?>
<package format="3">
  <name>go2_control_gateway</name>
  <version>0.1.0</version>
  <description>Fail-closed external-to-internal control gateway for Unitree Go2.</description>
  <maintainer email="wangzheie@example.com">wangzheie</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>unitree_go</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
