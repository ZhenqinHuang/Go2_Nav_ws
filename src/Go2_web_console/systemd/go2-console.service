[Unit]
Description=Go2 authenticated LAN control console
After=network-online.target go2-console-rosbridge.service
Wants=network-online.target go2-console-rosbridge.service

[Service]
Type=simple
User=nvidia
Group=nvidia
WorkingDirectory=/home/nvidia/go2_web_console
Environment=ROS_DISTRO=foxy
Environment=PYTHONUNBUFFERED=1
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file:///etc/go2-console/cyclonedds_wlan0.xml
ExecStart=/bin/bash -lc 'source /opt/ros/foxy/setup.bash && source /home/nvidia/unitree_ros2/install/setup.bash && source /home/nvidia/Go2_Nav_ws/install/setup.bash && source /home/nvidia/go2_web_console/install/setup.bash && exec ros2 run go2_web_console go2_console --bind 192.168.0.101 --port 8080 --password-hash-file /etc/go2-console/password.hash'
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
